    "class-validator": "^0.14.1",
    "joi": "^17.13.3",
    "mammoth": "^1.8.0",
    "mongoose": "^8.7.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.68.0",
    "pdf-parse": "^1.1.1",
