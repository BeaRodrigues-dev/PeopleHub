# Servidor
PORT=3001
NODE_ENV=development

# CORS — origens do frontend separadas por vírgula
CORS_ORIGIN=http://localhost:5173

# MongoDB (ver docker-compose.yml para subir localmente)
MONGODB_URI=mongodb://localhost:27017/talentflow

# OpenAI — opcional em desenvolvimento. Sem chave, o AiService cai
# automaticamente para um provider mock determinístico (ver src/modules/ai).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Upload de currículos
UPLOAD_DIR=./uploads
UPLOAD_MAX_SIZE_MB=5

# Autenticação (conta única) — OBRIGATÓRIO definir em produção. Sem estes
# valores, o sistema cai para credenciais padrão de desenvolvimento, cujo
# hash fica commitado no repositório e não protege nada publicamente.
AUTH_EMAIL=beatriz@peoplehub.local
AUTH_PASSWORD=
AUTH_SECRET=
